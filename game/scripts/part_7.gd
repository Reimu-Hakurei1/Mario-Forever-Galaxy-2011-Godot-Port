static func script_new_weapon_in_shop(S, A: Array) -> Variant:
    if (1 - R.eqv(S, G.ktory_juz_level_bron, G.ktory_juz_level)):
        if (G.shopmax > 43):
            G.dodaj_do_sklepu_bron = 0
        if (G.shopmax2 > 9):
            G.dodaj_do_sklepu_support = 0
        if (G.shopmax > 43):
            G.shopmax = 43
        if (G.shopmax2 > 9):
            G.shopmax2 = 9
