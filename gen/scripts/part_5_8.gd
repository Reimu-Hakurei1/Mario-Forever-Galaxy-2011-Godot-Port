            R.inst_set(S.g_drop, "szansa", 800)
            R.inst_set(S.g_drop, "sila_monet", 3)
            R.inst_set(S.g_drop, "sila_diamentow", 1.2)
            R.inst_set(S.g_drop, "moneta_vs_diament", 800)
        if R.eqv(S, S.g_oberwanie, 1):
            S.g_efekt = 1.1
            S.g_oberwanie = 2
        if R.eqv(S, S.g_oberwanie, 2):
            if (S.g_efekt > 0):
                S.g_efekt -= 0.1
            if (S.g_efekt < 0):
                S.g_oberwanie = 0
                S.g_efekt = 0
        if R.eqv(S, R.aget(S.g_sekwencja, 0), 0):
            if ((R.aget(S.g_pozycja, 0) >= 0) and (R.aget(S.g_pozycja, 0) < 8)):
