            R.set_obj_var(3, "g_losowacz", 4)
            R.set_obj_var(0, "g_iyor", (R.get_obj_var(0, "g_iyor") + 2))
        S.y = (S.y + S.g_taktyka)
        S.x = (S.x + S.g_taktyka4)
        S.g_image_angle += S.g_bujanie
        if (S.y > (R.room_height + 200)):
