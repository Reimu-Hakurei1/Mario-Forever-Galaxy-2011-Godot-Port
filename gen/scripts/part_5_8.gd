                S.g_doy = 64
            if ((R.aget(S.g_pozycja, 0) >= 8) and (R.aget(S.g_pozycja, 0) < 15)):
                S.g_dox = (((100 + (R.aget(S.g_pozycja, 0) * 80)) - (8 * 80)) + R.get_obj_var(532, "g_ruch2"))
                S.g_doy = 128
            if ((R.aget(S.g_pozycja, 0) >= 15) and (R.aget(S.g_pozycja, 0) < 21)):
                S.g_dox = (((140 + (R.aget(S.g_pozycja, 0) * 80)) - (15 * 80)) + R.get_obj_var(532, "g_ruch3"))
                S.g_doy = 196
